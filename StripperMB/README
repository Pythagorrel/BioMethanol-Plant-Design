# ==========================================

# 3. INTERPOLATION FUNCTIONS

# ==========================================


function bilinear_interpolate(x_vals, y_vals, grid, x_target, y_target)

    # x = Rows (Tr), y = Cols (Pr)

    

    i = findlast(v -> v <= x_target, x_vals)

    j = findlast(v -> v <= y_target, y_vals)


    if isnothing(i) i = 1 end

    if isnothing(j) j = 1 end

    if i >= length(x_vals) i = length(x_vals) - 1 end

    if j >= length(y_vals) j = length(y_vals) - 1 end


    x1, x2 = x_vals[i], x_vals[i+1]

    y1, y2 = y_vals[j], y_vals[j+1]

    

    Q11 = grid[i, j]

    Q21 = grid[i+1, j]

    Q12 = grid[i, j+1]

    Q22 = grid[i+1, j+1]


    denom = (x2 - x1) * (y2 - y1)

    

    if denom == 0 return Q11 end


    t1 = (x2 - x_target) * (y2 - y_target) * Q11

    t2 = (x_target - x1) * (y2 - y_target) * Q21

    t3 = (x2 - x_target) * (y_target - y1) * Q12

    t4 = (x_target - x1) * (y_target - y1) * Q22


    return (t1 + t2 + t3 + t4) / denom

end


function get_phi_lee_kesler(T, P, s::Species)

    Tr = T / s.Tc

    Pr = P / s.Pc


    if Tr > 4.0

        Tr = 4.0

    elseif Tr < 0.3

        return NaN

    end


    if Pr <= 1.0

        phi0 = bilinear_interpolate(LK_TR_ROWS, LK_PR_COLS_LOW, PHI0_LOW_DATA, Tr, Pr)

        phi1 = bilinear_interpolate(LK_TR_ROWS, LK_PR_COLS_LOW, PHI1_LOW_DATA, Tr, Pr)

    else

        phi0 = bilinear_interpolate(LK_TR_ROWS, LK_PR_COLS_HIGH, PHI0_HIGH_DATA, Tr, Pr)

        phi1 = bilinear_interpolate(LK_TR_ROWS, LK_PR_COLS_HIGH, PHI1_HIGH_DATA, Tr, Pr)

    end

    

    return phi0 * (phi1 ^ s.omega)

end


function get_phi_pitzer(T, P, s::Species)

    Tr = T / s.Tc

    Pr = P / s.Pc

    

    B0 = 0.083 - (0.422 / (Tr^1.6))

    B1 = 0.139 - (0.172 / (Tr^4.2))

    B_hat = B0 + s.omega * B1

    

    ln_phi = B_hat * (Pr / Tr)

    return exp(ln_phi)

end


# ==========================================

# 4. EXPORTED FUNCTION

# ==========================================


"""

    fugacity(T, P)


Calculate the fugacity coefficients for a predefined set of species (CH3OH, CO2, CO, H2, H2O)

at the given temperature `T` (Kelvin) and pressure `P` (bar).


Returns a Dictionary where keys are chemical formulas and values are the fugacity coefficients.

"""

function fugacity(T, P)

    results = Dict{String, Float64}()

    

    for s in SPECS

        val = 0.0

        if s.name == "H2" 

            val = get_phi_pitzer(T, P, s)

        else

            val = get_phi_lee_kesler(T, P, s)

        end

        results[s.name] = val

    end

    

    return results

end


end # module


it uses Lee Kesler and Pitzer not SRK

Thank you for providing the code! That correction regarding the Equation of State (Lee-Kesler/Pitzer instead of SRK) is crucial for the documentation.

Here is the finalized README.md text. You can create a file named README.md inside your Thermodynamic Model folder and paste this content directly.
Thermodynamic Model: CO₂ Hydrogenation to Methanol

This directory contains the thermodynamic modeling engine for the Biomethanol Plant Design project.

It has been structured as a modular Julia package ecosystem. Rather than running isolated scripts, the physics logic is split into dedicated packages (located in Modules/) which are all linked and exposed through the central ThermodynamicModel interface.
📦 Available Functions

By running using ThermodynamicModel, you gain access to the following functions for plant simulation.
1. Equilibrium Constants (BioMethEQK)

Calculates the chemical equilibrium constant (K) for the three primary reactions involved in methanol synthesis.

    Functions:

        EQConst1(T): Reaction 1 (CO2​+3H2​↔CH3​OH+H2​O)

        EQConst2(T): Reaction 2 (CO+2H2​↔CH3​OH)

        EQConst3(T): Reaction 3 (RWGS: CO2​+H2​↔CO+H2​O)

    Input: T (Temperature in Kelvin)

    Returns: Float (The dimensionless equilibrium constant K)

2. Non-Ideality / Fugacity (FugacityCo)

Calculates the fugacity coefficients (ϕ) to account for gas-phase non-ideality at high pressures.

    Function: fugacity(T, P)

    Methodology:

        Hydrogen (H2​): Calculated using the Pitzer correlation.

        Other Species: Calculated using the Lee-Kesler tables (generalized correlations).

    Inputs:

        T: Temperature (Kelvin)

        P: Pressure (bar)

    Returns: A Dictionary where keys are chemical formulas ("CH3OH", "CO2", etc.) and values are the fugacity coefficients.

3. Reactor Solver (RxnCo)

The primary numerical solver that determines the equilibrium composition of the reactor.

    Function: rxnco(T, P, phi, guess, feed_co2, feed_h2)

    Inputs:

        T: Temperature (Kelvin)

        P: Pressure (bar)

        phi: The dictionary output from fugacity(T, P)

        guess: A vector [x, y] representing initial guesses for the extent of reactions.

        feed_co2 / feed_h2: Molar flow rates of the feed components.

    Returns: An NLsolve object.

        Access the solution vector via .zero.

        Check convergence via converged(sol).

4. Plant Performance Metrics

These functions take the converged solution from the reactor and calculate key efficiency indicators.

    Functions:

        yieldF(roots): Calculates Methanol Yield.

        selectivityF(roots): Calculates Selectivity of Methanol vs. side products.

        conv(roots): Calculates CO₂ per-pass conversion.

    Input: roots (The vector result from the rxnco solver).

🚀 How to Run the Model
1. Initial Setup

Because this is a packaged environment, you must instantiate the dependencies once before running.

    Open this folder in your terminal.

    Launch Julia and enter the Package Manager (press ]).

    Run:
    Julia

    (v1.x) pkg> activate .
    (ThermodynamicModel) pkg> instantiate

2. Running a Simulation

We have provided a master script, Test Case.jl, that automatically loads the environment and runs a simulation sweep across a range of Pressures (50-100 bar) and Temperatures.

To run it:
Julia

julia> include("Test Case.jl")

3. Editing the Simulation

To simulate different plant conditions, open Test Case.jl and modify the FEED PARAMETERS section at the top:
Julia

# ==========================================
# 2. FEED PARAMETERS 
# ==========================================
FEED_CO2 = 1.0  # Change feed basis
FEED_H2  = 3.0  # Change stoichiometric ratio (e.g., set to 2.5 or 4.0)

You can also adjust T_range and P_range in the execution loop to generate data for sensitivity analysis graphs.

